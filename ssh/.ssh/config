Host github.com
    User git
    IdentityFile ~/.ssh/github/id_ed25519

Host *
    # Use 1Password as the SSH agent. Keys live in the 1Password vault;
    # biometric/system unlock authorises each use. Falls back to
    # IdentityFile if the agent socket isn't there.
    IdentityAgent ~/.1password/agent.sock

    # Connection multiplexing: reuse a single TCP per host for 10 minutes.
    # Socket dir is created by install.sh.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h:%p
    ControlPersist 10m
