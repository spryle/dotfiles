Host github.com
    User git
    IdentityFile ~/.ssh/github/id_ed25519

# isoterra prod (AWS Lightsail, eu-west-2). See infra/lightsail/README.md.
Host db.isoterra.online 3.9.86.47 isoterra-prod
    HostName db.isoterra.online
    User ubuntu
    IdentityFile ~/.ssh/aws/LightsailDefaultKey-eu-west-2.pem
    IdentitiesOnly yes

Host *
    # Use 1Password as the SSH agent. Keys live in the 1Password vault;
    # biometric/system unlock authorises each use. Falls back to
    # IdentityFile if the agent socket isn't there.
    IdentityAgent ~/.1password/agent.sock

    # Connection multiplexing: reuse a single TCP per host for 10 minutes.
    # Socket dir is created by install.sh.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h:%p
    ControlPersist 10m
